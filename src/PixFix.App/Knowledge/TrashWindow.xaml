<Window x:Class="PixFix.App.Knowledge.TrashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Papierkorb – Wissensdatenbank"
        Width="640" Height="420"
        Background="{DynamicResource AppWindowBackground}"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Wiederherstellen" Padding="12,3" Click="OnRestore" IsDefault="True" />
            <Button Content="Endgültig löschen" Padding="12,3" Margin="8,0,0,0" Click="OnDelete" />
            <Button Content="Schließen" Padding="12,3" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                   Text="Gelöschte Einträge. „Endgültig löschen“ entfernt den Eintrag; Bilddateien bleiben in der Ablage erhalten." />
        <ListView x:Name="Items" SelectionMode="Single" MouseDoubleClick="OnRestore"
                  Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Titel" Width="280" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Abschnitt" Width="160" DisplayMemberBinding="{Binding SectionName}" />
                    <GridViewColumn Header="Gelöscht am" Width="140"
                                    DisplayMemberBinding="{Binding DeletedUtc.LocalDateTime, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
