<UserControl x:Class="PixFix.App.Knowledge.KnowledgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PixFix.App.Common"
             xmlns:local="clr-namespace:PixFix.App.Knowledge"
             xmlns:editing="clr-namespace:PixFix.App.Editing">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" MinWidth="220" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Suche und Trefferliste -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="SearchBox"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4,3"
                         ToolTip="Sucht in Titel, Abschnitt, Tags, Bildtext (OCR) und Inhalt. Esc leert die Suche.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Suchen …" Margin="7,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="0,6,0,4">
                <CheckBox DockPanel.Dock="Left" Content="Archiv" IsChecked="{Binding ShowArchived}" VerticalAlignment="Center" Margin="0,0,8,0"
                          ToolTip="Archivierte Einträge mit anzeigen" />
                <TextBlock Text="{Binding Summary}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            </DockPanel>
            <common:ActionBar DockPanel.Dock="Top" Margin="0,0,0,4">
                <Button Style="{StaticResource ActionButton}" Content="_Neu ▾" Click="OnNewEntry" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.NewEntry}" common:ActionButton.Role="Create"
                        common:ActionButton.Description="Neuen Eintrag im Abschnitt des ausgewählten Eintrags anlegen – leer oder aus einer Vorlage (Strg+N)" />
                <Button Style="{StaticResource ActionButton}" Content="_Bildsuche …" Command="{Binding ImageSearchCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.ImageSearch}" common:ActionButton.Role="Action"
                        common:ActionButton.Description="Ähnliche Fehlerbilder zu einem Screenshot finden (Strg+Umschalt+B)" />
                <Button Style="{StaticResource ActionButton}" Content="Ab_schnitte …" Command="{Binding ManageSectionsCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.Sections}"
                        common:ActionButton.Description="Abschnitte umbenennen, sortieren oder leere Abschnitte löschen" />
                <Button Style="{StaticResource ActionButton}" Content="_Papierkorb" Command="{Binding ShowTrashCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.Trash}" common:ActionButton.Role="Danger"
                        common:ActionButton.Description="Gelöschte Einträge wiederherstellen oder endgültig löschen" />
            </common:ActionBar>
            <ListBox ItemsSource="{Binding ResultsView}"
                     SelectedItem="{Binding SelectedHit}"
                     Background="{DynamicResource AppSurfaceBackground}"
                     BorderBrush="{DynamicResource AppBorderBrush}"
                     BorderThickness="1"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </ListBox.InputBindings>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="2,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:KnowledgeHit}">
                        <StackPanel Margin="2,3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="★ " Foreground="Goldenrod"
                                           Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text=" (archiviert)" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding IsArchived, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                            <TextBlock Text="{Binding SnippetOrSection}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxHeight="48"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" common:LayoutMemory.Key="knowledge.splitter" />

        <!-- Ohne Auswahl: Hinweis statt eines leeren, scheinbar beschreibbaren Editors -->
        <StackPanel Grid.Column="2" Margin="20,16" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="Kein Eintrag ausgewählt" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Wähle links einen Eintrag aus oder lege mit „Neu“ einen neuen an. Ein Fehlerbild findest du auch über „Bildsuche …“ (Strg+Umschalt+B)." />
            <Button Content="Neuen Eintrag anlegen" Command="{Binding NewEntryCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,4"
                    Style="{StaticResource ActionButton}" common:ActionButton.Role="Primary" />
        </StackPanel>

        <!-- Eintrag -->
        <DockPanel Grid.Column="2" Margin="8,0,0,0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedEntry}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <!-- Kopf: Titel, Abschnitt, Tags, Zustände -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" IsEnabled="{Binding SelectedEntry, Converter={x:Static editing:NotNullConverter.Instance}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding EditTitle}" IsReadOnly="{Binding IsReadOnly}"
                         FontSize="18" FontWeight="SemiBold" BorderThickness="0,0,0,1" ToolTip="Titel" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <ToggleButton Style="{StaticResource ActionToggleButton}" Content="Favorit" IsChecked="{Binding SelectedEntry.IsFavorite, Mode=OneWay}"
                                  Command="{Binding ToggleFavoriteCommand}" common:ActionButton.Icon="{StaticResource Icon.Favorite}"
                                  common:ActionButton.Description="Als Favorit markieren" />
                    <ToggleButton Style="{StaticResource ActionToggleButton}" Content="Geschützt" Margin="2,0,0,0" IsChecked="{Binding SelectedEntry.IsProtected, Mode=OneWay}"
                                  Command="{Binding ToggleProtectedCommand}" common:ActionButton.Icon="{StaticResource Icon.Protected}"
                                  common:ActionButton.Description="Nicht bearbeitbar und nicht löschbar" />
                    <ToggleButton Style="{StaticResource ActionToggleButton}" Content="Archiv" Margin="2,0,0,0" IsChecked="{Binding SelectedEntry.IsArchived, Mode=OneWay}"
                                  Command="{Binding ToggleArchivedCommand}" common:ActionButton.Icon="{StaticResource Icon.Archive}"
                                  common:ActionButton.Description="Archivierte Einträge erscheinen nicht in der normalen Suche" />
                    <Button Style="{StaticResource ActionButton}" Content="Nach oben" Margin="8,0,0,0" Command="{Binding MoveUpCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.MoveUp}" common:ActionButton.Description="Eintrag im Abschnitt nach oben (Alt+↑)" />
                    <Button Style="{StaticResource ActionButton}" Content="Nach unten" Margin="2,0,0,0" Command="{Binding MoveDownCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.MoveDown}" common:ActionButton.Description="Eintrag im Abschnitt nach unten (Alt+↓)" />
                    <Button Style="{StaticResource ActionButton}" Content="Löschen" Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.Delete}" common:ActionButton.Role="Danger"
                            common:ActionButton.Description="In den Papierkorb verschieben (Entf in der Liste)" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Abschnitt" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox Width="200" IsEditable="True" ItemsSource="{Binding SectionNames}" Text="{Binding EditSection}"
                              IsEnabled="{Binding CanEdit}"
                              ToolTip="Abschnitt wählen oder neuen Namen eintippen" />
                    <TextBlock Text="Tags" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0,6,0" />
                    <TextBox Width="260" Text="{Binding EditTags}" IsReadOnly="{Binding IsReadOnly}"
                             ToolTip="Stichwörter für die Suche, z. B. Fehlernummern oder Programmnamen" />
                </StackPanel>
            </Grid>

            <editing:DocumentEditor x:Name="EditorPanel" />
        </DockPanel>
    </Grid>
</UserControl>
