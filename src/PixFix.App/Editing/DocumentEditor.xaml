<UserControl x:Class="PixFix.App.Editing.DocumentEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:PixFix.App.Common">
    <!-- Wiederverwendbarer Editor: DataContext ist ein IDocumentEditorHost (Wissensdatenbank, Schreibbereiche). -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Margin" Value="0,0,2,2" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CommandTarget" Value="{Binding ElementName=Editor}" />
            <Setter Property="Focusable" Value="False" />
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <!-- Formatleiste -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="HitNavigation" Visibility="Collapsed">
                <TextBlock x:Name="HitCounter" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button Style="{StaticResource ActionButton}" Content="Vorheriger Treffer" Padding="6,3" Click="OnPreviousHit" Focusable="False"
                        common:ActionButton.Icon="{StaticResource Icon.PreviousHit}" common:ActionButton.Description="Umschalt+F3" />
                <Button Style="{StaticResource ActionButton}" Content="Nächster Treffer" Padding="6,3" Margin="2,0,0,0" Click="OnNextHit" Focusable="False"
                        common:ActionButton.Icon="{StaticResource Icon.NextHit}" common:ActionButton.Description="F3" />
            </StackPanel>
            <WrapPanel IsEnabled="{Binding CanEdit}">
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleBold" Content="Fett" common:ActionButton.Icon="{StaticResource Icon.Bold}" common:ActionButton.Description="Strg+B" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleItalic" Content="Kursiv" common:ActionButton.Icon="{StaticResource Icon.Italic}" common:ActionButton.Description="Strg+I" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleUnderline" Content="Unterstrichen" common:ActionButton.Icon="{StaticResource Icon.Underline}" common:ActionButton.Description="Strg+U" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.IncreaseFontSize" Content="Größer" common:ActionButton.Icon="{StaticResource Icon.FontLarger}" common:ActionButton.Description="Schrift größer (Strg+])" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.DecreaseFontSize" Content="Kleiner" common:ActionButton.Icon="{StaticResource Icon.FontSmaller}" common:ActionButton.Description="Schrift kleiner (Strg+[)" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleBullets" Content="Aufzählung" common:ActionButton.Icon="{StaticResource Icon.Bullets}" />
                <Button Style="{StaticResource ToolButton}" Command="EditingCommands.ToggleNumbering" Content="Nummerierung" common:ActionButton.Icon="{StaticResource Icon.Numbering}" />
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Undo" Content="Rückgängig" common:ActionButton.Icon="{StaticResource Icon.Undo}" common:ActionButton.Description="Strg+Z" />
                <Button Style="{StaticResource ToolButton}" Command="ApplicationCommands.Redo" Content="Wiederholen" common:ActionButton.Icon="{StaticResource Icon.Redo}" common:ActionButton.Description="Strg+Y" />
                <Button Style="{StaticResource ToolButton}" Content="Bild einfügen …" Click="OnInsertImage"
                        common:ActionButton.Icon="{StaticResource Icon.InsertImage}"
                        common:ActionButton.Description="Bilddatei einfügen. Screenshots einfach mit Strg+V einfügen oder Dateien hineinziehen." />
                <Button Style="{StaticResource ToolButton}" Content="Kopier-Button" Click="OnAddCopyAction"
                        common:ActionButton.Icon="{StaticResource Icon.CopyButton}"
                        common:ActionButton.Description="Aus dem markierten Text einen Kopier-Button machen, z. B. für Befehle oder Pfade" />
                <Button Style="{StaticResource ToolButton}" Content="Bausteine ▾" Click="OnSnippets"
                        common:ActionButton.Icon="{StaticResource Icon.Snippets}"
                        common:ActionButton.Description="Lösungsbaustein an der Cursorposition einfügen, markierten Text als Baustein speichern oder Bausteine verwalten" />
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0" />
            </WrapPanel>
        </DockPanel>

        <!-- Kopier-Buttons des Eintrags -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,4">
            <WrapPanel.Style>
                <Style TargetType="WrapPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CopyActions.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </WrapPanel.Style>
            <TextBlock Text="Kopieren:" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ItemsControl ItemsSource="{Binding CopyActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button MaxWidth="320" Margin="0,0,4,2" Padding="8,3" FontFamily="Consolas"
                                Command="{Binding DataContext.CopyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                ToolTip="{Binding Text}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Kopier-Button löschen"
                                              Command="{Binding PlacementTarget.Tag.DeleteCopyActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              CommandParameter="{Binding}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Tag>
                                <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                            </Button.Tag>
                            <!-- TextBlock statt Content-Text: Unterstriche (z. B. in Pfaden) sonst als Tastenkürzel verschluckt -->
                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </WrapPanel>

        <Grid>
            <RichTextBox x:Name="Editor"
                         IsReadOnly="{Binding IsReadOnly}"
                         IsDocumentEnabled="True"
                         IsInactiveSelectionHighlightEnabled="True"
                         AcceptsTab="True"
                         SpellCheck.IsEnabled="True"
                         Language="de-DE"
                         VerticalScrollBarVisibility="Auto"
                         AllowDrop="True"
                         Background="{DynamicResource AppSurfaceBackground}"
                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                         BorderBrush="{DynamicResource AppBorderBrush}"
                         BorderThickness="1" />
            <TextBlock Text="Dokument wird geladen …"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Visibility="{Binding IsLoadingDocument, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
