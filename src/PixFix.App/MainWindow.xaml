<Window x:Class="PixFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PixFix.App.Common"
        xmlns:calls="clr-namespace:PixFix.App.Calls"
        xmlns:ti="clr-namespace:PixFix.App.Ti"
        xmlns:knowledge="clr-namespace:PixFix.App.Knowledge"
        xmlns:settings="clr-namespace:PixFix.App.Settings"
        xmlns:workspaces="clr-namespace:PixFix.App.Workspaces"
        Title="PixFix"
        Icon="pack://application:,,,/pix-fix.ico"
        Width="1400"
        Height="850"
        MinWidth="900"
        MinHeight="500"
        Background="{DynamicResource AppWindowBackground}"
        WindowStartupLocation="CenterScreen"
        common:LayoutMemory.Key="main">
    <Window.InputBindings>
        <!-- Bereiche: Strg+1 … Strg+5 -->
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="1" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="2" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="3" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="4" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="5" />
        <KeyBinding Key="NumPad1" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="1" />
        <KeyBinding Key="NumPad2" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="2" />
        <KeyBinding Key="NumPad3" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="3" />
        <KeyBinding Key="NumPad4" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="4" />
        <KeyBinding Key="NumPad5" Modifiers="Control" Command="{Binding ShowSectionCommand}" CommandParameter="5" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- Je Bereich die passende Ansicht zum ViewModel -->
        <DataTemplate DataType="{x:Type knowledge:KnowledgeViewModel}">
            <knowledge:KnowledgeView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type workspaces:WorkspacesViewModel}">
            <workspaces:WorkspacesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type calls:CallsViewModel}">
            <calls:CallsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type ti:TiMonitorViewModel}">
            <ti:TiMonitorView />
        </DataTemplate>
        <ti:TiStateBrushConverter x:Key="TiBrush" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <DataTemplate DataType="{x:Type settings:SettingsViewModel}">
            <settings:SettingsView />
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="190" MinWidth="150" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppSidebarBackground}"
                BorderBrush="{DynamicResource AppDividerBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="6,8,6,4">
                    <Button DockPanel.Dock="Left"
                            Command="{Binding ToggleSidebarCommand}"
                            MinWidth="36"
                            Padding="8,6"
                            Background="Transparent"
                            BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="ToolTip" Value="Seitenleiste einklappen" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="ToolTip" Value="Seitenleiste ausklappen" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="&#xE700;" FontFamily="Segoe MDL2 Assets" FontSize="15" />
                    </Button>
                    <TextBlock Text="Navigation"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </DockPanel>
                <TextBlock DockPanel.Dock="Bottom" Margin="8" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"
                           Text="{Binding DataDirectory, StringFormat='Daten: {0}'}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- TI-Status immer sichtbar; blinkt rot bei einer neuen Störung, Klick öffnet den Monitor -->
                <Button DockPanel.Dock="Bottom" Padding="8,6" Cursor="Hand" HorizontalContentAlignment="Stretch"
                        Command="{Binding ShowTiCommand}" ToolTip="{Binding Ti.Headline}"
                        Visibility="{Binding Ti.IsEnabled, Converter={StaticResource Visible}}"
                        Background="{Binding Ti.State, Converter={StaticResource TiBrush}}" BorderThickness="0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Margin" Value="8,0,8,6" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Margin" Value="6,0,6,8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Ti.IsBlinking}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="TiBlink">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.55" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="TiBlink" />
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="TI-Monitor" Foreground="White" FontWeight="Bold" />
                            <TextBlock Text="{Binding Ti.Headline}" Foreground="White" FontSize="10" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Text="TI" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Button>
                <ListBox ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="4"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,6" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,1" ToolTip="{Binding Title}">
                                <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Width="22" TextAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" common:LayoutMemory.Key="main.splitter" />

        <Grid Grid.Column="2" Margin="16">
            <ContentControl x:Name="SectionHost" Content="{Binding SelectedSection.Content}" Focusable="False" />
            <!-- Nach dem Löschen: „Rückgängig“ (12 Sekunden) -->
            <Border DataContext="{Binding Undo}" Visibility="{Binding IsVisible, Converter={StaticResource Visible}}"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" Padding="14,8"
                    Background="#323A45" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Panel.ZIndex="10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Text}" Foreground="White" VerticalAlignment="Center" MaxWidth="520" TextTrimming="CharacterEllipsis" />
                    <Button Content="Rückgängig" Command="{Binding UndoCommand}" Margin="16,0,0,0" Padding="10,2" FontWeight="SemiBold" />
                    <Button Content="✕" Command="{Binding DismissCommand}" Margin="6,0,0,0" Padding="6,2" Background="Transparent"
                            Foreground="White" BorderThickness="0" ToolTip="Hinweis schließen" />
                </StackPanel>
            </Border>
            <!-- Platzhalter für Bereiche, die noch nicht umgesetzt sind -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSection.Content}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding SelectedSection.Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedSection.Description}" Margin="0,8,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
