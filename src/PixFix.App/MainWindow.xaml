<Window x:Class="PixFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixFix"
        Width="1280"
        Height="800"
        MinWidth="800"
        MinHeight="500"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox Grid.Column="0"
                 ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 DisplayMemberPath="Title"
                 BorderThickness="0"
                 Padding="4" />

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" />

        <DockPanel Grid.Column="2" Margin="24">
            <StackPanel DockPanel.Dock="Top">
                <TextBlock Text="{Binding SelectedSection.Title}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedSection.Description}" Margin="0,8,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DataDirectory, StringFormat='Datenordner: {0}'}"
                           Margin="0,16,0,0"
                           Foreground="Gray" />
            </StackPanel>

            <!-- Import aus PixFix 69 (nur unter „Einstellungen“) -->
            <DockPanel Margin="0,24,0,0"
                       DataContext="{Binding Import}"
                       Visibility="{Binding DataContext.IsSettingsSelected,
                                    RelativeSource={RelativeSource AncestorType=Window},
                                    Converter={StaticResource BoolToVisibility}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Daten aus PixFix 69 übernehmen" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                               Text="Liest Datenbank, Bilder, Dokumente, PDFs, Fax-Dokumente und Vorlagen aus einem PixFix-69-Ordner. Die Altdaten werden nicht verändert. Stimmt eine Anzahl nicht, wird nichts übernommen." />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="PixFix-69-Ordner wählen und importieren …"
                                Command="{Binding ImportCommand}"
                                Padding="12,4" />
                        <TextBlock Text="{Binding Status}" Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <TextBox Margin="0,12,0,0"
                         Text="{Binding ReportText, Mode=OneWay}"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" />
            </DockPanel>
        </DockPanel>
    </Grid>
</Window>
