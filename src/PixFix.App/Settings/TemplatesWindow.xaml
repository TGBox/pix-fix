<Window x:Class="PixFix.App.Settings.TemplatesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PixFix.App.Common"
        Title="PixFix – Vorlagen und Schnelltexte" Width="980" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource AppWindowBackground}"
        common:LayoutMemory.Key="templates">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="ListButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Multi" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Padding" Value="3" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="12">
        <Button DockPanel.Dock="Bottom" Content="Schließen" IsCancel="True" HorizontalAlignment="Right" Padding="16,3" Margin="0,10,0,0" />
        <TabControl>
            <!-- Vorlagen aller Arten -->
            <TabItem Header="Vorlagen">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <ComboBox DockPanel.Dock="Top" ItemsSource="{Binding Kinds}" SelectedItem="{Binding SelectedKind}" DisplayMemberPath="Title" />
                        <common:ActionBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Neu" Command="{Binding NewTemplateCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.Add}" common:ActionButton.Role="Create" />
                            <Button Content="Löschen" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.Delete}" common:ActionButton.Role="Danger" />
                            <Button Content="Nach oben" Command="{Binding MoveTemplateUpCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.MoveUp}" />
                            <Button Content="Nach unten" Command="{Binding MoveTemplateDownCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.MoveDown}" />
                        </common:ActionBar>
                        <ListBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" DisplayMemberPath="Name" Margin="0,6,0,0"
                                 Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" />
                    </DockPanel>
                    <DockPanel Grid.Column="1" DataContext="{Binding SelectedTemplate}">
                        <DockPanel.Style>
                            <Style TargetType="DockPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DockPanel.Style>
                        <TextBlock DockPanel.Dock="Top" Text="Name" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBox DockPanel.Dock="Top" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=500}" Padding="3,2" />
                        <StackPanel DockPanel.Dock="Top"
                                    Visibility="{Binding DataContext.SelectedKind.HasSubject, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                            <TextBlock Text="Betreff" Style="{StaticResource Label}" />
                            <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged, Delay=500}" Padding="3,2"
                                     common:PlaceholderBar.AcceptsPlaceholders="True" />
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Text" Style="{StaticResource Label}" />
                        <TextBlock DockPanel.Dock="Bottom" Margin="0,2,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                                   Text="{Binding DataContext.SelectedKind.Hint, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <common:PlaceholderBar DockPanel.Dock="Bottom" Margin="0,8,0,0"
                                               Visibility="{Binding DataContext.SelectedKind.HasPlaceholders, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}" />
                        <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged, Delay=500}" Style="{StaticResource Multi}"
                                 common:PlaceholderBar.AcceptsPlaceholders="True" />
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- Cobra-Schnelltexte -->
            <TabItem Header="Cobra-Schnelltexte">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Margin="0,0,12,0">
                        <common:ActionBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Content="Neu" Command="{Binding NewQuickTextCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.Add}" common:ActionButton.Role="Create" />
                            <Button Content="Löschen" Command="{Binding DeleteQuickTextCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.Delete}" common:ActionButton.Role="Danger" />
                            <Button Content="Nach oben" Command="{Binding MoveQuickTextUpCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.MoveUp}" />
                            <Button Content="Nach unten" Command="{Binding MoveQuickTextDownCommand}" Style="{StaticResource ListButton}"
                                    common:ActionButton.Icon="{StaticResource Icon.MoveDown}" />
                        </common:ActionBar>
                        <ListBox ItemsSource="{Binding QuickTexts}" SelectedItem="{Binding SelectedQuickText}" DisplayMemberPath="Name"
                                 Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" />
                    </DockPanel>
                    <StackPanel Grid.Column="1" DataContext="{Binding SelectedQuickText}">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Name (im Menü „Schnelltexte“)" Style="{StaticResource Label}" Margin="0,0,0,2" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Delay=500}" Padding="3,2" />
                        <TextBlock Text="Text für Cobra (Zwischenablage)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding CobraText, UpdateSourceTrigger=PropertyChanged, Delay=500}" Style="{StaticResource Multi}" Height="70" />
                        <TextBlock Text="An die Notizen anhängen (z. B. NE,)" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding NotesText, UpdateSourceTrigger=PropertyChanged, Delay=500}" Padding="3,2" />
                        <TextBlock Text="An die Lösung anhängen" Style="{StaticResource Label}" />
                        <TextBox Text="{Binding WorkText, UpdateSourceTrigger=PropertyChanged, Delay=500}" Style="{StaticResource Multi}" Height="70" />
                        <TextBlock Text="Danach" Style="{StaticResource Label}" />
                        <CheckBox Content="Anruf auf „Erledigt“ setzen" IsChecked="{Binding CompleteCall}" Margin="0,2,0,0" />
                        <CheckBox Content="Anruf auf „Später erneut anrufen“ setzen (mit Erinnerung)" IsChecked="{Binding ScheduleRecall}" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- Fax-Dokumente -->
            <TabItem Header="Fax-Dokumente">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,8"
                               Text="Beim Klick auf „Fax“ im Anruf wählst du eines dieser Dokumente aus; PixFix öffnet eine Kopie mit dem zugeordneten Programm (z. B. Word). Die Originale bleiben unverändert in der PixFix-Ablage und gehören zur Sicherung." />
                    <common:ActionBar DockPanel.Dock="Bottom" Margin="0,6,0,0">
                        <Button Content="Hinzufügen …" Command="{Binding AddFaxCommand}" Style="{StaticResource ListButton}"
                                common:ActionButton.Icon="{StaticResource Icon.Add}" common:ActionButton.Role="Create"
                                common:ActionButton.Description="Dokument auswählen – oder per Drag &amp; Drop aus dem Explorer" />
                        <Button Content="Öffnen" Command="{Binding OpenFaxCommand}" Style="{StaticResource ListButton}"
                                common:ActionButton.Icon="{StaticResource Icon.Open}" common:ActionButton.Role="Action" />
                        <Button Content="Entfernen" Command="{Binding RemoveFaxCommand}" Style="{StaticResource ListButton}"
                                common:ActionButton.Icon="{StaticResource Icon.Delete}" common:ActionButton.Role="Danger" />
                        <Button Content="Nach oben" Command="{Binding MoveFaxUpCommand}" Style="{StaticResource ListButton}"
                                common:ActionButton.Icon="{StaticResource Icon.MoveUp}" />
                        <Button Content="Nach unten" Command="{Binding MoveFaxDownCommand}" Style="{StaticResource ListButton}"
                                common:ActionButton.Icon="{StaticResource Icon.MoveDown}" />
                    </common:ActionBar>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" DataContext="{Binding SelectedFax}">
                        <TextBlock Text="Anzeigename" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Padding="3,2" />
                    </DockPanel>
                    <ListBox ItemsSource="{Binding FaxDocuments}" SelectedItem="{Binding SelectedFax}" DisplayMemberPath="Name"
                             Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                             AllowDrop="True" DragOver="OnFaxDragOver" Drop="OnFaxDrop"
                             ToolTip="Dokumente auch per Drag &amp; Drop aus dem Explorer hinzufügen" />
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
