<UserControl x:Class="PixFix.App.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Import aus PixFix 69 (SPEC F12) -->
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Daten aus PixFix 69 übernehmen" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                       Text="Liest Datenbank, Bilder, Dokumente, PDFs, Fax-Dokumente und Vorlagen aus einem PixFix-69-Ordner. Die Altdaten werden nicht verändert. Stimmt eine Anzahl nicht, wird nichts übernommen." />
            <Button Content="PixFix-69-Ordner wählen und importieren …"
                    Command="{Binding ImportCommand}"
                    HorizontalAlignment="Left"
                    Padding="12,4" />
            <Grid Margin="0,12,0,0" Height="22">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0} %'}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBox Margin="0,12,0,0"
                 Text="{Binding ReportText, Mode=OneWay}"
                 IsReadOnly="True"
                 FontFamily="Consolas"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" />
    </DockPanel>
</UserControl>
