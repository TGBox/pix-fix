<UserControl x:Class="PixFix.App.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <TabControl>
        <TabItem Header="Anrufe">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel DataContext="{Binding Calls}" Margin="8" MaxWidth="760" HorizontalAlignment="Left">
                    <TextBlock Text="Telefonie" FontSize="16" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Nummern wählen über" Width="180" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding DialMethods}" SelectedItem="{Binding DialMethod}" Width="300" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="„Windows-Standard (tel:)“ öffnet die Nummer im zugeordneten Telefonieprogramm (z. B. Unify Phone). Auflegen läuft unabhängig davon immer über TAPI." />

                    <TextBlock Text="E-Mail" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="E-Mail-Programm" Width="180" VerticalAlignment="Center" />
                        <ComboBox ItemsSource="{Binding MailPrograms}" SelectedItem="{Binding MailProgram}" Width="300" HorizontalAlignment="Left" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="„Outlook Classic“ öffnet einen Entwurf in Outlook Desktop; „Windows-Standard“ nutzt mailto:." />

                    <TextBlock Text="Rechnungs-Mail (kostenpflichtiger Support)" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Empfänger" Width="180" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BillingMailRecipient, UpdateSourceTrigger=LostFocus}" Padding="3,2" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Betreff" Width="180" VerticalAlignment="Center" />
                        <TextBox Text="{Binding BillingMailSubject, UpdateSourceTrigger=LostFocus}" Padding="3,2" />
                    </DockPanel>
                    <DockPanel Margin="0,6,0,0">
                        <TextBlock Text="Text" Width="180" VerticalAlignment="Top" Margin="0,3,0,0" />
                        <TextBox Text="{Binding BillingMailBody, UpdateSourceTrigger=LostFocus}" Height="140" Padding="3"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Platzhalter: {LNUM}, {ID}, {WARUM}, {LOESUNG}, {EMAIL}, {FAX}. Die Mail öffnet sich über den Button „Rechnungs-Mail“ und wenn du einen kostenpflichtigen Anruf auf „Erledigt“ setzt und sie noch nicht versendet wurde." />

                    <TextBlock Text="Vorlagen" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,0" />
                    <Button Content="Vorlagen, Cobra-Schnelltexte und Fax-Dokumente bearbeiten …" Command="{Binding OpenTemplatesCommand}"
                            HorizontalAlignment="Left" Padding="12,4" Margin="0,6,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Sicherung">
            <DockPanel DataContext="{Binding Backup}" Margin="8">
                <StackPanel DockPanel.Dock="Top" MaxWidth="820" HorizontalAlignment="Left">
                    <TextBlock Text="Sicherungsordner" FontSize="16" FontWeight="SemiBold" />
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Öffnen" Command="{Binding OpenFolderCommand}" Padding="10,2" Margin="4,0,0,0" />
                        <Button DockPanel.Dock="Right" Content="Standard" Command="{Binding ResetFolderCommand}" Padding="10,2" Margin="4,0,0,0"
                                ToolTip="Wieder den PixFix-Datenordner verwenden" />
                        <Button DockPanel.Dock="Right" Content="Ändern …" Command="{Binding ChangeFolderCommand}" Padding="10,2" Margin="8,0,0,0" />
                        <TextBox Text="{Binding BackupFolder, Mode=OneWay}" IsReadOnly="True" Padding="3,2" />
                    </DockPanel>
                    <TextBlock Margin="0,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Hier landen die automatischen Sicherungen, „Jetzt sichern“ und die Sicherung vor jeder Wiederherstellung. Ein OneDrive-Ordner schützt zusätzlich vor einem Rechnerausfall." />

                    <CheckBox Content="Automatisch sichern" IsChecked="{Binding AutoBackupEnabled}" Margin="0,14,0,0" FontWeight="SemiBold" />
                    <TextBlock Margin="20,4,0,0" Foreground="Gray" TextWrapping="Wrap"
                               Text="Eine Sicherung pro Tag (AUTO-Datum.pixfix), höchstens alle 4 Stunden aktualisiert und nur, wenn du PixFix gerade nicht benutzt. Tagessicherungen werden 7 Tage aufbewahrt." />
                    <TextBlock Margin="20,4,0,0" Text="{Binding LastAutoBackupText}" TextWrapping="Wrap" />

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="Jetzt sichern" Command="{Binding BackupNowCommand}" Padding="12,4" Margin="0,0,6,6" FontWeight="SemiBold" />
                        <Button Content="Sichern unter …" Command="{Binding BackupAsCommand}" Padding="12,4" Margin="0,0,6,6" />
                        <Button Content="Sicherung prüfen …" Command="{Binding VerifyCommand}" Padding="12,4" Margin="0,0,6,6" />
                        <Button Content="Sicherung wiederherstellen …" Command="{Binding RestoreCommand}" Padding="12,4" Margin="0,0,6,6" />
                    </WrapPanel>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap"
                               Text="Wiederherstellen liest PixFix-Sicherungen und Sicherungen aus PixFix 69 (Format 3.0). Die Sicherung wird vorher vollständig geprüft; erst danach werden die Daten ausgetauscht." />
                    <Grid Margin="0,12,0,0" Height="22">
                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0} %'}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <TextBox Margin="0,12,0,0" Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" />
            </DockPanel>
        </TabItem>
        <TabItem Header="Import aus PixFix 69">
                <!-- Import aus PixFix 69 (SPEC F12) -->
                <DockPanel DataContext="{Binding Import}" Margin="8">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Daten aus PixFix 69 übernehmen" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,8" TextWrapping="Wrap"
                                   Text="Liest Datenbank, Bilder, Dokumente, PDFs, Fax-Dokumente und Vorlagen aus einem PixFix-69-Ordner. Die Altdaten werden nicht verändert. Stimmt eine Anzahl nicht, wird nichts übernommen. Sind in PixFix schon Daten vorhanden, werden sie nach Rückfrage ersetzt und vorher gesichert." />
                        <Button Content="PixFix-69-Ordner wählen und importieren …"
                                Command="{Binding ImportCommand}"
                                HorizontalAlignment="Left"
                                Padding="12,4" />
                        <Grid Margin="0,12,0,0" Height="22">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                            <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0} %'}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding Status}" Margin="0,6,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBox Margin="0,12,0,0"
                             Text="{Binding ReportText, Mode=OneWay}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" />
                </DockPanel>
        </TabItem>
    </TabControl>
</UserControl>
