<Window x:Class="PixFix.App.Calls.ReminderScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="16">
        <TextBlock x:Name="Info" TextWrapping="Wrap" Margin="0,0,0,10" />
        <GroupBox x:Name="QuickGroup" Header="Schnellwahl" Margin="0,0,0,10">
            <WrapPanel Margin="4">
                <Button Content="5 Min" Width="64" Margin="2" Tag="5" Click="OnQuick" />
                <Button Content="10 Min" Width="64" Margin="2" Tag="10" Click="OnQuick" />
                <Button Content="15 Min" Width="64" Margin="2" Tag="15" Click="OnQuick" />
                <Button Content="30 Min" Width="64" Margin="2" Tag="30" Click="OnQuick" />
                <Button Content="1 Std" Width="64" Margin="2" Tag="60" Click="OnQuick" />
            </WrapPanel>
        </GroupBox>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Datum" />
                <DatePicker x:Name="DateBox" Margin="0,4,0,0" SelectedDateFormat="Short" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Uhrzeit (HH:mm)" />
                <TextBox x:Name="TimeBox" Margin="0,4,0,0" Padding="2,3" TextAlignment="Center" GotKeyboardFocus="OnTimeFocus" />
            </StackPanel>
        </Grid>
        <TextBlock x:Name="Error" Foreground="Firebrick" TextWrapping="Wrap" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Erinnerung speichern" Padding="12,3" IsDefault="True" Click="OnSave" />
            <Button Content="Abbrechen" Padding="12,3" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
