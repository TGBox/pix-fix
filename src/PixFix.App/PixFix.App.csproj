<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Nur für das Symbol im Infobereich (NotifyIcon); WinForms-Namensräume werden nicht global eingebunden. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>PixFix.App</RootNamespace>
    <AssemblyName>PixFix</AssemblyName>
    <!-- Programmsymbol (Explorer, Taskleiste, Verknüpfungen) -->
    <ApplicationIcon>..\..\assets\pix-fix.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- Distribution: dotnet publish -c Release -> single PixFix.exe without installed .NET -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- WPF Fluent ThemeMode is still flagged experimental (WPF0001) in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!-- WPF Fluent ThemeMode is marked experimental (WPF0001) in .NET 10. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>
  <ItemGroup>
    <!-- Dasselbe Symbol als WPF-Ressource für Fenster und Infobereich -->
    <Resource Include="..\..\assets\pix-fix.ico" Link="pix-fix.ico" />
    <!-- Symbolschrift (Auszug aus Fluent UI System Icons, MIT) – erzeugt von scripts/build-icon-font.py -->
    <Resource Include="Assets\Fonts\PixFixIcons.ttf" />
  </ItemGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PixFix.Core\PixFix.Core.csproj" />
    <ProjectReference Include="..\PixFix.Infrastructure\PixFix.Infrastructure.csproj" />
  </ItemGroup>
</Project>
