<UserControl x:Class="PixFix.App.Workspaces.WorkspacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:common="clr-namespace:PixFix.App.Common"
             xmlns:editing="clr-namespace:PixFix.App.Editing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>

        <!-- Bereich, Suche, Reiter nach Abschnitten -->
        <DockPanel Grid.Column="0" Margin="0,0,8,0">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Style="{StaticResource ActionButton}" Content="Bereiche …" Margin="4,0,0,0" Command="{Binding ManageWorkspacesCommand}"
                        common:ActionButton.Icon="{StaticResource Icon.Edit}"
                        common:ActionButton.Description="Bereiche anlegen, umbenennen, sortieren und schützen" />
                <ComboBox ItemsSource="{Binding Workspaces}" SelectedItem="{Binding SelectedWorkspace}" FontSize="14">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" />
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock Text=" 🔒" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProtected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,6,0,0">
                <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged, Delay=250}" Padding="4,3"
                         ToolTip="Sucht in Titel, Abschnitt und Inhalt der Reiter dieses Bereichs. Esc leert die Suche.">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Escape" Command="{Binding ClearSearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Text="Im Bereich suchen …" Margin="7,4,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <common:ActionBar DockPanel.Dock="Top" Margin="0,6,0,2">
                <Button Style="{StaticResource ActionButton}" Content="Neuer _Reiter" Command="{Binding NewEntryCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.NewTab}" common:ActionButton.Role="Create"
                        common:ActionButton.Description="Neuen Reiter im Abschnitt des ausgewählten Reiters anlegen (Strg+N)" />
                <Button Style="{StaticResource ActionButton}" Content="Abschnitt hoch" Command="{Binding MoveSectionUpCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.MoveUp}"
                        common:ActionButton.Description="Abschnitt des ausgewählten Reiters nach oben" />
                <Button Style="{StaticResource ActionButton}" Content="Abschnitt runter" Command="{Binding MoveSectionDownCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.MoveDown}"
                        common:ActionButton.Description="Abschnitt des ausgewählten Reiters nach unten" />
                <Button Style="{StaticResource ActionButton}" Content="Papier_korb" Command="{Binding ShowTrashCommand}" Margin="0,0,4,4"
                        common:ActionButton.Icon="{StaticResource Icon.Trash}" common:ActionButton.Role="Danger"
                        common:ActionButton.Description="Gelöschte Reiter wiederherstellen" />
            </common:ActionBar>
            <ListBox ItemsSource="{Binding EntriesView}" SelectedItem="{Binding SelectedItem}"
                     Background="{DynamicResource AppSurfaceBackground}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1"
                     DisplayMemberPath="Title" HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.InputBindings>
                    <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
                </ListBox.InputBindings>
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <!-- Ein-/Ausklappen gilt für den ganzen Abschnitt und wird gespeichert -->
                                            <Expander IsExpanded="{Binding Items[0].IsExpanded, Mode=TwoWay}" Margin="0,2,0,2">
                                                <Expander.Header>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                </Expander.Header>
                                                <ItemsPresenter Margin="12,0,0,0" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" common:LayoutMemory.Key="workspaces.splitter" />

        <!-- Ohne Auswahl: Hinweis statt eines leeren, scheinbar beschreibbaren Editors -->
        <StackPanel Grid.Column="2" Margin="20,16" MaxWidth="480" HorizontalAlignment="Left" VerticalAlignment="Top">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- Noch kein Bereich: Reiter gibt es erst in einem Bereich, also zuerst dorthin führen -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Noch kein Bereich vorhanden" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Reiter liegen immer in einem Bereich, z. B. „Aktuelle Fehler“ oder „Werkzeuge“. Lege zuerst einen Bereich an, danach kannst du darin Reiter anlegen." />
                <Button Content="Bereich anlegen …" Command="{Binding ManageWorkspacesCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,4"
                        Style="{StaticResource ActionButton}" common:ActionButton.Role="Primary" />
            </StackPanel>
            <!-- Bereich vorhanden, nur kein Reiter ausgewählt -->
            <StackPanel>
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedWorkspace}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Kein Reiter ausgewählt" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Wähle links einen Reiter aus oder lege mit „Neuer Reiter“ eine neue Seite an. Weitere Bereiche legst du oben über „Bereiche …“ an." />
                <Button Content="Neuen Reiter anlegen" Command="{Binding NewEntryCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" Padding="12,4"
                        Style="{StaticResource ActionButton}" common:ActionButton.Role="Primary" />
            </StackPanel>
        </StackPanel>

        <!-- Reiter -->
        <DockPanel Grid.Column="2" Margin="8,0,0,0">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Hidden" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <!-- PDF-Dateien aus dem Explorer hierher ziehen = anhängen -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6" IsEnabled="{Binding SelectedItem, Converter={x:Static editing:NotNullConverter.Instance}}"
                  AllowDrop="True" Background="Transparent" DragOver="OnAttachmentDragOver" Drop="OnAttachmentDrop">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding EditTitle}" IsReadOnly="{Binding IsReadOnly}"
                         FontSize="18" FontWeight="SemiBold" BorderThickness="0,0,0,1" ToolTip="Titel des Reiters" />
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <ToggleButton Style="{StaticResource ActionToggleButton}" Content="Geschützt" IsChecked="{Binding SelectedItem.Item.IsProtected, Mode=OneWay}"
                                  Command="{Binding ToggleProtectedCommand}" common:ActionButton.Icon="{StaticResource Icon.Protected}"
                                  common:ActionButton.Description="Nicht bearbeitbar und nicht löschbar" />
                    <Button Style="{StaticResource ActionButton}" Content="Nach oben" Margin="8,0,0,0" Command="{Binding MoveUpCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.MoveUp}" common:ActionButton.Description="Reiter im Abschnitt nach oben" />
                    <Button Style="{StaticResource ActionButton}" Content="Nach unten" Margin="2,0,0,0" Command="{Binding MoveDownCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.MoveDown}" common:ActionButton.Description="Reiter im Abschnitt nach unten" />
                    <Button Style="{StaticResource ActionButton}" Content="Löschen" Margin="8,0,0,0" Command="{Binding DeleteCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.Delete}" common:ActionButton.Role="Danger"
                            common:ActionButton.Description="Reiter in den Papierkorb verschieben (Entf in der Liste)" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,6,0,0">
                    <TextBlock Text="Abschnitt" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,6,0" />
                    <ComboBox Width="220" IsEditable="True" ItemsSource="{Binding SectionNames}" Text="{Binding EditSection}"
                              IsEnabled="{Binding CanEdit}" ToolTip="Abschnitt wählen oder neuen Namen eintippen" />
                    <Button Style="{StaticResource ActionButton}" Content="Per _Mail …" Margin="12,0,0,0" Click="OnSendMail"
                            common:ActionButton.Icon="{StaticResource Icon.Mail}" common:ActionButton.Role="Action"
                            common:ActionButton.Description="Reiter als Outlook-Entwurf öffnen – mit Formatierung, Bildern und PDF-Anhängen" />
                    <Button Style="{StaticResource ActionButton}" Content="_PDF anhängen …" Margin="6,0,0,0" Command="{Binding AddAttachmentCommand}"
                            common:ActionButton.Icon="{StaticResource Icon.Attach}" common:ActionButton.Role="Action"
                            common:ActionButton.Description="PDF auswählen – oder PDF-Dateien aus dem Explorer auf den Kopf des Reiters ziehen" />
                </StackPanel>
                <!-- PDF-Anhänge -->
                <ItemsControl Grid.Row="2" Grid.ColumnSpan="2" ItemsSource="{Binding Attachments}" Margin="0,6,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,4,2" Padding="6,1"
                                    Command="{Binding DataContext.OpenAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" ToolTip="PDF öffnen">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Anhang entfernen"
                                                  Command="{Binding PlacementTarget.Tag.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Tag>
                                    <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </Button.Tag>
                                <TextBlock Text="{Binding DisplayName, StringFormat='📄 {0}'}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <editing:DocumentEditor x:Name="EditorPanel" />
        </DockPanel>
    </Grid>
</UserControl>
