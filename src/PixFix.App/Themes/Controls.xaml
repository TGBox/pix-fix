<!--
  Gemeinsame Schaltflächen-Stile (SPEC F16 „Darstellung“).

  Verwendung:
    <Button Style="{StaticResource ActionButton}" Content="_Anrufen"
            ui:ActionButton.Icon="{StaticResource Icon.Call}" ui:ActionButton.Role="Primary"
            ui:ActionButton.Description="Nummer aus „Rückruf an“ wählen" />

  - Content bleibt die Beschriftung samt Zugriffstaste; sie ist in jeder Darstellung per Alt erreichbar
    (in „Nur Symbol“ auf Breite 0 statt ausgeblendet, damit die Taste registriert bleibt).
  - Tooltip = Beschriftung mit Alt-Kürzel + Description; ein ToolTip direkt am Element ersetzt ihn.
  - Role färbt nur in „Farbig“ (ohne Role: grau); Primary (Hauptaktion) immer.
  Wird nach dem Fluent-Theme in App.OnStartup geladen, damit BasedOn den Fluent-Stil findet.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:PixFix.App.Common"
                    xmlns:editing="clr-namespace:PixFix.App.Editing">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="Icons.xaml" />
  </ResourceDictionary.MergedDictionaries>

  <ui:ActionToolTipConverter x:Key="ActionToolTip" />

  <!-- Logos der Fernwartungsprogramme (aus assets/*.svg übernommen, Koordinaten absolut) -->
  <PathGeometry x:Key="Logo.AnyDesk"
                Figures="M8.322,3.677 L0,12 L8.322,20.323 L16.645,12 Z M15.693,3.687 L13.844,5.537 L20.334,11.993 L13.844,18.483 L15.694,20.3 L24,11.993 Z" />
  <!-- TeamViewer: nur der Doppelpfeil, gefüllt und ohne Kreis (wird dadurch im 16-px-Feld größer) -->
  <PathGeometry x:Key="Logo.TeamViewer"
                Figures="M5.101,24 L18.838,17.012 L17.091,21.74 L30.909,21.74 L29.162,17.012 L42.899,24 L29.162,30.988 L30.909,26.26 L17.091,26.26 L18.838,30.988 Z" />

  <!-- Symbol + Beschriftung; die Darstellung (Nur Symbol / Symbol und Text / Nur Text) folgt Appearance.Current. -->
  <DataTemplate x:Key="ActionButtonContent">
    <StackPanel Orientation="Horizontal">
      <TextBlock x:Name="Glyph"
                 Text="{Binding Path=(ui:ActionButton.Icon), RelativeSource={RelativeSource AncestorType=ButtonBase}}"
                 FontFamily="{DynamicResource AppIconFont}" FontSize="16" VerticalAlignment="Center" />
      <!-- Logo als Vektorgrafik (ActionButton.IconGeometry), z. B. AnyDesk und TeamViewer -->
      <Path x:Name="Logo" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Visibility="Collapsed"
            Data="{Binding Path=(ui:ActionButton.IconGeometry), RelativeSource={RelativeSource AncestorType=ButtonBase}}"
            Fill="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}"
            Stroke="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=ButtonBase}}" StrokeThickness="0"
            StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
      <ContentPresenter x:Name="Label" Content="{Binding}" RecognizesAccessKey="True" VerticalAlignment="Center" Margin="6,0,0,0" />
    </StackPanel>
    <DataTemplate.Triggers>
      <!-- Logo statt Schriftzeichen -->
      <DataTrigger Binding="{Binding Path=(ui:ActionButton.IconGeometry), RelativeSource={RelativeSource AncestorType=ButtonBase}, Converter={x:Static editing:NotNullConverter.Instance}}" Value="True">
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Logo" Property="Visibility" Value="Visible" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Path=(ui:ActionButton.IconStroked), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="True">
        <Setter TargetName="Logo" Property="Fill" Value="{x:Null}" />
        <Setter TargetName="Logo" Property="StrokeThickness" Value="1.5" />
      </DataTrigger>
      <DataTrigger Binding="{Binding LabelMode, Source={x:Static ui:Appearance.Current}}" Value="IconOnly">
        <Setter TargetName="Label" Property="MaxWidth" Value="0" />
        <Setter TargetName="Label" Property="Margin" Value="0" />
      </DataTrigger>
      <DataTrigger Binding="{Binding LabelMode, Source={x:Static ui:Appearance.Current}}" Value="TextOnly">
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Logo" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Label" Property="Margin" Value="0" />
      </DataTrigger>
      <!-- Ohne Symbol und ohne Logo: immer die Beschriftung (steht zuletzt, gewinnt also). -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding Path=(ui:ActionButton.Icon), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="{x:Null}" />
          <Condition Binding="{Binding Path=(ui:ActionButton.IconGeometry), RelativeSource={RelativeSource AncestorType=ButtonBase}}" Value="{x:Null}" />
        </MultiDataTrigger.Conditions>
        <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
        <Setter TargetName="Label" Property="MaxWidth" Value="Infinity" />
        <Setter TargetName="Label" Property="Margin" Value="0" />
      </MultiDataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <!-- Gefärbte Fläche für Rollen; Hover/Gedrückt als Überlagerung in Schriftfarbe, damit jede Rolle reagiert. -->
  <ControlTemplate x:Key="RoleButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="1" CornerRadius="4" SnapsToDevicePixels="True">
      <Grid>
        <Border x:Name="Overlay" CornerRadius="3" Background="{TemplateBinding Foreground}" Opacity="0" />
        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Overlay" Property="Opacity" Value="0.12" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Overlay" Property="Opacity" Value="0.24" />
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Root" Property="Opacity" Value="0.45" />
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="ContentTemplate" Value="{StaticResource ActionButtonContent}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTip">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource ActionToolTip}">
          <Binding Path="Content" RelativeSource="{RelativeSource Self}" />
          <Binding Path="(ui:ActionButton.Description)" RelativeSource="{RelativeSource Self}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <!-- Hauptaktion: in beiden Darstellungen in Akzentfarbe -->
      <Trigger Property="ui:ActionButton.Role" Value="Primary">
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRolePrimaryBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRolePrimaryForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRolePrimaryBorder}" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Trigger>
      <!-- „Farbig“: Aktionen ohne besondere Bedeutung grau statt weiß, damit sie zum Schema der farbigen passen -->
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsColorful, Source={x:Static ui:Appearance.Current}}" Value="True" />
          <Condition Binding="{Binding Path=(ui:ActionButton.Role), RelativeSource={RelativeSource Self}}" Value="Neutral" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRoleNeutralBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRoleNeutralForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRoleNeutralBorder}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsColorful, Source={x:Static ui:Appearance.Current}}" Value="True" />
          <Condition Binding="{Binding Path=(ui:ActionButton.Role), RelativeSource={RelativeSource Self}}" Value="Create" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRoleCreateBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRoleCreateForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRoleCreateBorder}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsColorful, Source={x:Static ui:Appearance.Current}}" Value="True" />
          <Condition Binding="{Binding Path=(ui:ActionButton.Role), RelativeSource={RelativeSource Self}}" Value="Danger" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRoleDangerBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRoleDangerForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRoleDangerBorder}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsColorful, Source={x:Static ui:Appearance.Current}}" Value="True" />
          <Condition Binding="{Binding Path=(ui:ActionButton.Role), RelativeSource={RelativeSource Self}}" Value="Warning" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRoleWarningBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRoleWarningForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRoleWarningBorder}" />
      </MultiDataTrigger>
      <MultiDataTrigger>
        <MultiDataTrigger.Conditions>
          <Condition Binding="{Binding IsColorful, Source={x:Static ui:Appearance.Current}}" Value="True" />
          <Condition Binding="{Binding Path=(ui:ActionButton.Role), RelativeSource={RelativeSource Self}}" Value="Action" />
        </MultiDataTrigger.Conditions>
        <Setter Property="Template" Value="{StaticResource RoleButtonTemplate}" />
        <Setter Property="Background" Value="{DynamicResource AppRoleActionBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource AppRoleActionForeground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AppRoleActionBorder}" />
      </MultiDataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Umschalter (Favorit, Geschützt, Archiv): Symbol-Darstellung wie ActionButton, Farbe vom Fluent-Stil (Akzent wenn an). -->
  <Style x:Key="ActionToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
    <Setter Property="ContentTemplate" Value="{StaticResource ActionButtonContent}" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
    <Setter Property="ToolTip">
      <Setter.Value>
        <MultiBinding Converter="{StaticResource ActionToolTip}">
          <Binding Path="Content" RelativeSource="{RelativeSource Self}" />
          <Binding Path="(ui:ActionButton.Description)" RelativeSource="{RelativeSource Self}" />
        </MultiBinding>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Platzhalter-Pill in Vorlagen: Klick fügt den Platzhalter am Cursor ein. -->
  <Style x:Key="PlaceholderPill" TargetType="Button">
    <Setter Property="Background" Value="{DynamicResource AppPillBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource AppPillForeground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AppPillBorder}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="10,2" />
    <Setter Property="FontFamily" Value="Consolas" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="11" Padding="{TemplateBinding Padding}">
            <Grid>
              <ContentPresenter VerticalAlignment="Center" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AppPillForeground}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
