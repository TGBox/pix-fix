<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App surface & structural hierarchy -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#F2F4F8" />
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#E3E8F0" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#B6C0CE" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#B6C0CE" />
    <SolidColorBrush x:Key="AppSplitterBackground" Color="#D9E0E9" />
    <SolidColorBrush x:Key="AppSplitterHoverBackground" Color="#A4B1C2" />
    <SolidColorBrush x:Key="AppInfoBarBackground" Color="#E3EFFA" />
    <SolidColorBrush x:Key="AppInfoBarBorderBrush" Color="#9CC3E8" />

    <!-- Farbige Schaltflächen (Einstellung „Farbig“; Primary = Hauptaktion auch in „Dezent“). Kontrast: ThemePaletteContrastTests -->
    <!-- Neutral nur in „Farbig“: graue Fläche statt weißer Fluent-Schaltfläche, ohne eine Bedeutung vorzutäuschen -->
    <SolidColorBrush x:Key="AppRoleNeutralBackground" Color="#616A75" />
    <SolidColorBrush x:Key="AppRoleNeutralForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppRoleNeutralBorder" Color="#616A75" />
    <SolidColorBrush x:Key="AppRolePrimaryBackground" Color="#005FB8" />
    <SolidColorBrush x:Key="AppRolePrimaryForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppRolePrimaryBorder" Color="#005FB8" />
    <SolidColorBrush x:Key="AppRoleCreateBackground" Color="#0F7B0F" />
    <SolidColorBrush x:Key="AppRoleCreateForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppRoleCreateBorder" Color="#0F7B0F" />
    <SolidColorBrush x:Key="AppRoleDangerBackground" Color="#C42B1C" />
    <SolidColorBrush x:Key="AppRoleDangerForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppRoleDangerBorder" Color="#C42B1C" />
    <SolidColorBrush x:Key="AppRoleWarningBackground" Color="#F7B32B" />
    <SolidColorBrush x:Key="AppRoleWarningForeground" Color="#1B1F24" />
    <SolidColorBrush x:Key="AppRoleWarningBorder" Color="#8A5300" />
    <SolidColorBrush x:Key="AppRoleActionBackground" Color="#0067C0" />
    <SolidColorBrush x:Key="AppRoleActionForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppRoleActionBorder" Color="#0067C0" />

    <!-- Fernwartung in Markenfarben, in beiden Darstellungen gleich (AnyDesk #EF443B, TeamViewer #050A52) -->
    <SolidColorBrush x:Key="AppBrandAnyDeskBackground" Color="#EF443B" />
    <SolidColorBrush x:Key="AppBrandAnyDeskForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBrandAnyDeskBorder" Color="#EF443B" />
    <SolidColorBrush x:Key="AppBrandTeamViewerBackground" Color="#050A52" />
    <SolidColorBrush x:Key="AppBrandTeamViewerForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBrandTeamViewerBorder" Color="#050A52" />

    <!-- Platzhalter-Pills in Vorlagen -->
    <SolidColorBrush x:Key="AppPillBackground" Color="#E1ECF8" />
    <SolidColorBrush x:Key="AppPillBorder" Color="#9CC3E8" />
    <SolidColorBrush x:Key="AppPillForeground" Color="#0B3D6E" />

    <!-- Fluent Light contrast overrides (replaces faint 6% strokes with crisp visible borders) -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#F2F4F8" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#B6C0CE" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#AAB5C5" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#B6C0CE" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#96A4B7" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#667282" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#BCC6D4" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#B6C0CE" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#C2CBD8" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#E8EEF5" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#D8E0EB" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#1B1F24" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#4C5664" />
    <SolidColorBrush x:Key="AppLinkForeground" Color="#005FB8" />
    <SolidColorBrush x:Key="AppLinkHoverForeground" Color="#004488" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#005FB8" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#004488" />
</ResourceDictionary>
