<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App surface & structural hierarchy -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#1E2025" />
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#16181D" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#252830" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3E4552" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#353B47" />
    <SolidColorBrush x:Key="AppSplitterBackground" Color="#2B303A" />
    <SolidColorBrush x:Key="AppSplitterHoverBackground" Color="#4A5363" />

    <!-- Fluent Dark contrast overrides -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1E2025" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#4A5363" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#5A6476" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8C96A8" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3C4350" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#252830" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#363D49" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343945" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2E333E" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#AAB3C2" />
    <SolidColorBrush x:Key="AppLinkForeground" Color="#75BEFF" />
    <SolidColorBrush x:Key="AppLinkHoverForeground" Color="#9ED2FF" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#75BEFF" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#9ED2FF" />
</ResourceDictionary>
