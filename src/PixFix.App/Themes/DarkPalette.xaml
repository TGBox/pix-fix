<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- App surface & structural hierarchy -->
    <SolidColorBrush x:Key="AppWindowBackground" Color="#1E2025" />
    <SolidColorBrush x:Key="AppSidebarBackground" Color="#16181D" />
    <SolidColorBrush x:Key="AppSurfaceBackground" Color="#252830" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3E4552" />
    <SolidColorBrush x:Key="AppDividerBrush" Color="#353B47" />
    <SolidColorBrush x:Key="AppSplitterBackground" Color="#2B303A" />
    <SolidColorBrush x:Key="AppSplitterHoverBackground" Color="#4A5363" />
    <SolidColorBrush x:Key="AppInfoBarBackground" Color="#1D3044" />
    <SolidColorBrush x:Key="AppInfoBarBorderBrush" Color="#36618A" />

    <!-- Farbige Schaltflächen (Einstellung „Farbig“; Primary = Hauptaktion auch in „Dezent“). Kontrast: ThemePaletteContrastTests -->
    <!-- Neutral nur in „Farbig“: graue Fläche, passend zu den hellen Rollenfarben im dunklen Thema -->
    <SolidColorBrush x:Key="AppRoleNeutralBackground" Color="#A3ABB8" />
    <SolidColorBrush x:Key="AppRoleNeutralForeground" Color="#14171C" />
    <SolidColorBrush x:Key="AppRoleNeutralBorder" Color="#A3ABB8" />
    <SolidColorBrush x:Key="AppRolePrimaryBackground" Color="#60CDFF" />
    <SolidColorBrush x:Key="AppRolePrimaryForeground" Color="#00243A" />
    <SolidColorBrush x:Key="AppRolePrimaryBorder" Color="#60CDFF" />
    <SolidColorBrush x:Key="AppRoleCreateBackground" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AppRoleCreateForeground" Color="#0B2008" />
    <SolidColorBrush x:Key="AppRoleCreateBorder" Color="#6CCB5F" />
    <SolidColorBrush x:Key="AppRoleDangerBackground" Color="#FF99A4" />
    <SolidColorBrush x:Key="AppRoleDangerForeground" Color="#3B0A10" />
    <SolidColorBrush x:Key="AppRoleDangerBorder" Color="#FF99A4" />
    <SolidColorBrush x:Key="AppRoleWarningBackground" Color="#FFC83D" />
    <SolidColorBrush x:Key="AppRoleWarningForeground" Color="#2B1E00" />
    <SolidColorBrush x:Key="AppRoleWarningBorder" Color="#FFC83D" />
    <SolidColorBrush x:Key="AppRoleActionBackground" Color="#5CB3FF" />
    <SolidColorBrush x:Key="AppRoleActionForeground" Color="#03203A" />
    <SolidColorBrush x:Key="AppRoleActionBorder" Color="#5CB3FF" />

    <!-- Fernwartung in Markenfarben, in beiden Darstellungen gleich (AnyDesk #EF443B, TeamViewer #050A52) -->
    <SolidColorBrush x:Key="AppBrandAnyDeskBackground" Color="#EF443B" />
    <SolidColorBrush x:Key="AppBrandAnyDeskForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBrandAnyDeskBorder" Color="#EF443B" />
    <SolidColorBrush x:Key="AppBrandTeamViewerBackground" Color="#050A52" />
    <SolidColorBrush x:Key="AppBrandTeamViewerForeground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AppBrandTeamViewerBorder" Color="#7A84E0" />

    <!-- Platzhalter-Pills in Vorlagen -->
    <SolidColorBrush x:Key="AppPillBackground" Color="#1D3044" />
    <SolidColorBrush x:Key="AppPillBorder" Color="#36618A" />
    <SolidColorBrush x:Key="AppPillForeground" Color="#BFE0FF" />

    <!-- Fluent Dark contrast overrides -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#1E2025" />
    <SolidColorBrush x:Key="ControlElevationBorderBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="TextControlElevationBorderBrush" Color="#4A5363" />
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#5A6476" />
    <SolidColorBrush x:Key="ControlStrongStrokeColorDefaultBrush" Color="#8C96A8" />
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#3C4350" />
    <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#252830" />
    <SolidColorBrush x:Key="SurfaceStrokeColorDefaultBrush" Color="#464E5D" />
    <SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#363D49" />
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#2A2E37" />
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#343945" />
    <SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#2E333E" />
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#F0F3F8" />
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#AAB3C2" />
    <SolidColorBrush x:Key="AppLinkForeground" Color="#75BEFF" />
    <SolidColorBrush x:Key="AppLinkHoverForeground" Color="#9ED2FF" />
    <SolidColorBrush x:Key="HyperlinkForeground" Color="#75BEFF" />
    <SolidColorBrush x:Key="HyperlinkForegroundPointerOver" Color="#9ED2FF" />
</ResourceDictionary>
