<Window x:Class="PixFix.App.Help.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PixFix – Einführung"
        Icon="pack://application:,,,/pix-fix.ico"
        Width="500" SizeToContent="Height"
        Background="{DynamicResource AppWindowBackground}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
  <Border BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="0,4,0,0">
    <StackPanel Margin="20,16,20,18">
      <TextBlock x:Name="Counter" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
      <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
      <TextBlock x:Name="Body" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" LineHeight="21" MinHeight="84" />
      <ProgressBar x:Name="Progress" Height="4" Margin="0,16,0,0" Minimum="0" />
      <DockPanel Margin="0,16,0,0" LastChildFill="False">
        <Button x:Name="CloseButton" DockPanel.Dock="Left" Content="Tour beenden" IsCancel="True" Click="OnClose"
                MinWidth="110" Padding="12,4" ToolTip="Die Tour lässt sich unter Hilfe jederzeit neu starten (F1)" />
        <Button x:Name="NextButton" DockPanel.Dock="Right" Content="Weiter" IsDefault="True" Click="OnNext"
                MinWidth="110" Padding="12,4" Margin="8,0,0,0" />
        <Button x:Name="BackButton" DockPanel.Dock="Right" Content="Zurück" Click="OnBack"
                MinWidth="110" Padding="12,4" />
      </DockPanel>
    </StackPanel>
  </Border>
</Window>
