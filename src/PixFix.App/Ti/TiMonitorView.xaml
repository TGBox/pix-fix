<UserControl x:Class="PixFix.App.Ti.TiMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ti="clr-namespace:PixFix.App.Ti"
             xmlns:tiInfra="clr-namespace:PixFix.Infrastructure.Ti;assembly=PixFix.Infrastructure">
    <UserControl.Resources>
        <ti:TiStateBrushConverter x:Key="StateBrush" />
        <BooleanToVisibilityConverter x:Key="Visible" />
        <Style x:Key="TiCardTextBase" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="TiIncidentText" TargetType="TextBlock" BasedOn="{StaticResource TiCardTextBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IncidentState}" Value="{x:Static tiInfra:TiState.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IncidentState}" Value="{x:Static tiInfra:TiState.Incident}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IncidentState}" Value="{x:Static tiInfra:TiState.Unknown}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TiLageText" TargetType="TextBlock" BasedOn="{StaticResource TiCardTextBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding LageState}" Value="{x:Static tiInfra:TiState.Ok}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LageState}" Value="{x:Static tiInfra:TiState.Incident}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding LageState}" Value="{x:Static tiInfra:TiState.Unknown}">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Deaktiviert -->
        <StackPanel>
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="TI-Monitor" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="Der TI-Monitor ist ausgeschaltet. Er lässt sich unter Einstellungen → TI-Monitor wieder einschalten." Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <DockPanel Visibility="{Binding IsEnabled, Converter={StaticResource Visible}}">
            <Border DockPanel.Dock="Top" CornerRadius="12" Padding="18" Background="{Binding State, Converter={StaticResource StateBrush}}">
                <TextBlock Text="{Binding Headline}" Foreground="White" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" />
            </Border>
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="{Binding IncidentText}" Style="{StaticResource TiIncidentText}" />
            </Border>
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,8,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <TextBlock Text="{Binding LageText}" Style="{StaticResource TiLageText}" />
            </Border>
            <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                <TextBlock DockPanel.Dock="Right" Text="{Binding LastCheckedText}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="TI-Status öffnen" Command="{Binding OpenStatusPageCommand}" Padding="12,4" Margin="0,0,6,0" />
                    <Button Content="TI-Lagebild öffnen" Command="{Binding OpenLagePageCommand}" Padding="12,4" Margin="0,0,6,0" />
                    <Button Content="Jetzt prüfen" Command="{Binding CheckNowCommand}" Padding="12,4" FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
            <ListBox ItemsSource="{Binding Details}" Margin="0,12,0,0" Background="{DynamicResource AppSurfaceBackground}" BorderThickness="1" BorderBrush="{DynamicResource AppBorderBrush}">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBox">
                                            <TextBlock Text="Keine Einzelmeldungen." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="8" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
            </ListBox>
        </DockPanel>
    </Grid>
</UserControl>
