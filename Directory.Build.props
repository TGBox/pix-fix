<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Lokale Builds sind Entwicklungsversionen ("-dev": keine automatische Update-Suche). Die echte Versionsnummer
         setzt .github/workflows/release.yml beim Veröffentlichen per -p:Version. -->
    <Version>1.0.0-dev</Version>
    <Company>Carasent</Company>
    <Product>PixFix</Product>
    <NeutralLanguage>de-DE</NeutralLanguage>
  </PropertyGroup>
</Project>
